# Keys required by the reused stock-signal-system agents (price/fundamentals/
# risk/news/classify_ticker + models/router.py) -- same keys that project uses,
# since these agents make real yfinance/Gemini/Groq/Cerebras/Tavily calls.
# CEREBRAS_API_KEY is P1's third model-routing fallback tier (Gemini -> Groq
# -> Cerebras), picked up automatically once P2's requirements.txt is pinned
# to a P1 tag that includes it -- see P1's models/router.py.
TAVILY_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# This project's own Judge model, if different from the above.
# ANTHROPIC_API_KEY=

# Keep debate-signal-system's writes out of stock-signal-system's database.
STOCK_SIGNAL_DB_PATH=./debate_signal.db
